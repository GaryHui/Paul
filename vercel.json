{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/automation/run-due",
      "schedule": "*/15 * * * *"
    }
  ],
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/automation/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/prediction/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/test/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
